{
  "formula": "json-workflow",
  "description": "Rendered Beads JSON workflow",
  "version": 1,
  "type": "workflow",
  "vars": {
    "release_name": { "required": true }
  },
  "steps": [
    {
      "id": "prepare",
      "title": "Prepare {{{ project.name }}} for {{ release_name }}",
      "description": "Keep the Beads placeholder: {{ release_name }}",
      "type": "task"
    }{% for reviewer in reviewers %},
    {
      "id": "review-{{{ reviewer.id }}}",
      "title": "Review {{{ reviewer.name }}} for {{ release_name }}",
      "type": "task"
    }{% endfor %}
  ]
}
