---
metadata:
  name: fuzz-run-case
  description: One adversarial-fuzz probe case as a copyable XHTML fragment.
required_variables:
  - case.campaign_id
  - case.case_id
  - case.worker_correlation_id
  - case.classification
  - case.summary
  - case.input_variables
  - case.json_payload
  - case.context_text
---
<section xmlns="http://www.w3.org/1999/xhtml" class="fuzz-case fuzz-case-{{ case.classification | lower }}">
  <header class="fuzz-case-header">
    <div>
      <p class="eyebrow">Adversarial fuzz case</p>
      <h2>{{ case.case_id }}</h2>
      <p class="case-meta">Campaign {{ case.campaign_id }} · Worker {{ case.worker_correlation_id }}</p>
    </div>
    <div class="case-actions" aria-label="Copy case data">
      <button type="button" class="icon-button" title="Copy JSON" data-copy-text="{{ case.copy_json | e }}">{}</button>
      <button type="button" class="icon-button" title="Copy Context" data-copy-text="{{ case.context_text | e }}">⎘</button>
    </div>
  </header>

  <p class="status">{{ case.classification }}</p>
  <p class="summary">{{ case.summary }}</p>

  <section class="input-variables">
    <h3>Input variables</h3>
    <table>
      <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
      <tbody>
{% for item in case.input_variables %}
        <tr><th scope="row">{{ item.name }}</th><td><code>{{ item.value }}</code></td></tr>
{% endfor %}
      </tbody>
    </table>
  </section>

{% if case.classification not in ["pass", "success", "successful", "ok"] %}
  <section class="failure-details">
    <h3>Expected versus observed</h3>
    <dl>
      <dt>Expected</dt><dd>{{ case.expected_oracle }}</dd>
      <dt>Observed</dt><dd>{{ case.observed_result }}</dd>
    </dl>
  </section>

  <section class="requirement-trace">
    <h3>Requirement / ADR trace</h3>
    <p>{{ case.requirement_trace }}</p>
  </section>

  <section class="requirement-follow-up">
    <h3>Requirement / ADR follow-up</h3>
    <p>{{ case.requirement_follow_up }}</p>
  </section>

  <section class="root-cause">
    <h3>Root-cause analysis</h3>
    <p>{{ case.root_cause }}</p>
  </section>

  <section class="recommended-fix">
    <h3>Recommended fix</h3>
    <p>{{ case.recommended_fix }}</p>
  </section>
{% endif %}
</section>
