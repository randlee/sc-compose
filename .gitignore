# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# macOS Finder metadata
.DS_Store

# Python build/test artifacts
__pycache__/
*.pyc
bindings/python/python/sc_compose/_native*.so

# Generated report evidence
reports/latest/
reports/archive/
.prompts/
.sc-compose/
.sc/*
!.sc/sc-lint/
!.sc/sc-lint/targets/
!.sc/sc-lint/targets/*.toml
.serena/
.tmp/
docs/phase-D/.review-findings.json

# Repowise build caches (keep knowledge-graph.json and config in git)
.repowise/centrality_cache.pkl
.repowise/duplication_cache.pkl
.repowise/duplication_pairs.pkl
.repowise/parse_cache.pkl
.repowise/wiki.db
.repowise/lancedb/
.repowise/jobs/
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
.repowise/sessions/
.repowise/state.json
.repowise/.augment-session.json
.repowise/.augment-warned
