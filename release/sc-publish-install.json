    "binaries": ["sc-compose"],
    "selector_dir": {
      "darwin": "~/.sc-compose-builds/selectors/darwin",
      "linux": "~/.sc-compose-builds/selectors/linux",
      "windows": "%LOCALAPPDATA%\\sc-compose\\prerelease-selectors"
    },
    "post_install": "{selector_dir}/sc-compose --version",
    "verify": "{selector_dir}/sc-compose --version",
    "protected_branches": ["develop", "main"]
  },
  "python_packages": [
    {"artifact": "sc-sha-python", "package": "sc-sha", "manifest": "bindings/sc-sha-python/pyproject.toml", "module": "sc_sha", "publish": "pypi"},
    {"artifact": "sc-compose-python", "package": "sc-compose", "manifest": "bindings/python/pyproject.toml", "module": "sc_compose", "publish": "pypi"},
    {"artifact": "sc-composer-beads-python", "package": "sc-composer-beads", "manifest": "bindings/sc-composer-beads-python/pyproject.toml", "module": "sc_composer_beads", "publish": "pypi"}
