{
  "schema_version": "phase-i4-xml-dirty-prefix/v1",
  "sprint": "I.4",
  "issue": "#193 Gap 5",
  "requirement_trace": [
    "docs/requirements.md FR-19",
    "docs/architecture.md section 8.5",
    "docs/adrs/0013-phase-i-raw-text-and-input-safety.md XML dirty-prefix recovery",
    "docs/phase-I/sprint-i-4-xml-dirty-prefix.md"
  ],
  "implementation": {
    "normalization": "rendered XML only, before XML parsing",
    "removed_span": "byte range from the original rendered input, with one-based line and column",
    "warning_code": "WARN_EXTRACT_DIRTY_PREFIX_STRIPPED",
    "fallback": "ERR_EXTRACT_MALFORMED for malformed suffixes, multiple roots, truncated prolog markup, and post-root content",
    "unsupported": "ERR_EXTRACT_UNSUPPORTED for DTD declarations"
  },
  "cases": [
    {
      "id": "plain-text-preamble",
      "kind": "success",
      "template_fixture": "xml-dirty-prefix.xml.j2",
      "rendered_fixture": "xml-dirty-prefix.xml",
      "rendered_input": "service response: 200\\n<root><value>Ada</value></root>\\n",
      "expected_values": {"value": "Ada"},
      "expected_warning": "WARN_EXTRACT_DIRTY_PREFIX_STRIPPED",
      "expected_detail": "bytes 0.. and line 2, column 1",
      "test": "fixture_normalizes_dirty_xml_prefix_and_reports_removed_span"
    },
    {
      "id": "declaration-comment-processing-instruction-prolog",
      "kind": "success",
      "template_fixture": "xml-dirty-prefix-prolog.xml.j2",
      "rendered_fixture": "xml-dirty-prefix-prolog.xml",
      "rendered_input": "gateway response\\n<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n<!-- response payload -->\\n<?trace id=\\\"42\\\"?>\\n<root><value>Ada</value></root>\\n",
      "expected_values": {"value": "Ada"},
      "expected_warning": "WARN_EXTRACT_DIRTY_PREFIX_STRIPPED",
      "test": "fixture_preserves_dirty_xml_prolog_and_i3_full_content"
    },
    {
      "id": "dirty-prefix-plus-i3-full-content",
      "kind": "success",
      "template_fixture": "xml-dirty-prefix-blocks.xml.j2",
      "rendered_fixture": "xml-dirty-prefix-blocks.xml",
      "expected_values": {"content": "<code>Ada</code><message>accepted</message>"},
      "expected_warning": "WARN_EXTRACT_DIRTY_PREFIX_STRIPPED",
      "test": "fixture_preserves_dirty_xml_prolog_and_i3_full_content"
    },
    {
      "id": "invalid-prefix-and-suffix-boundaries",
      "kind": "rejected",
      "fixtures": [
        "xml-dirty-prefix-multiple-root.xml",
        "xml-dirty-prefix-malformed-suffix.xml",
        "xml-dirty-prefix-unterminated-comment.xml",
        "xml-dirty-prefix-unterminated-pi.xml",
        "xml-dirty-prefix-ambiguous.xml"
      ],
      "inline_inputs": [
        "<root><value>Ada</value></root><!-- after root -->",
        "<root><value>Ada</value></root><?xml version=\\\"1.0\\\"?>"
      ],
      "expected_error": "ERR_EXTRACT_MALFORMED",
      "test": "dirty_xml_prefix_rejections_are_not_silently_dropped"
    },
    {
      "id": "doctype-boundary",
      "kind": "rejected",
      "rendered_input": "<!DOCTYPE root><root><value>Ada</value></root>",
      "expected_error": "ERR_EXTRACT_UNSUPPORTED",
      "test": "dirty_xml_prefix_rejections_are_not_silently_dropped"
    }
  ],
  "surface_parity": [
    "crates/sc-composer/tests/extract_integration.rs",
    "crates/sc-compose/tests/cli/extract.rs",
    "crates/sc-compose/tests/json_cli/extract.rs",
    "bindings/python/tests/test_smoke.py"
  ],
  "validation": {
    "focused_commands": [
      "cargo test -p sc-composer --test extract_integration dirty_xml_prefix -- --nocapture",
