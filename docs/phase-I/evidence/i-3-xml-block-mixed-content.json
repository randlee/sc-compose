      "id": "description-inline-markup",
      "kind": "success",
      "review_note": "QA task descriptions commonly contain prose with inline code or emphasis; this is a realistic block value rather than a scalar-only field.",
      "template": "<repo-qa-task>\n  <description>{{ description }}</description>\n</repo-qa-task>",
      "rendered": "<repo-qa-task>\n  <description>Fix the XML extractor in <code>sc-compose</code> and preserve &amp; review evidence.</description>\n</repo-qa-task>",
      "expected_report": {
        "values": {
          "description": "Fix the XML extractor in <code>sc-compose</code> and preserve &amp; review evidence."
        },
        "occurrence": {
          "variable": "description",
          "path": [
            { "kind": "element", "name": "repo-qa-task", "ordinal": 0 },
            { "kind": "element", "name": "description", "ordinal": 0 }
          ],
          "source": { "kind": "element_content" }
        }
      },
      "test": "fixture_extracts_xml_block_text_and_mixed_content_with_canonical_markup"
    },
    {
      "id": "references-repeated-and-escaped",
      "kind": "success",
      "review_note": "Issue and reference blocks are common in ATM task payloads and combine repeated child names, attributes, URLs, and escaped text.",
      "template": "<references>{{ references }}</references>",
      "rendered": "<references><issue number=\"193\">Gap 1</issue><link>https://github.com/randlee/sc-compose/issues/193</link></references>",
      "expected_report": {
        "values": {
          "references": "<issue number=\"193\">Gap 1</issue><link>https://github.com/randlee/sc-compose/issues/193</link>"
        },
        "occurrence": {
          "variable": "references",
          "path": [
            { "kind": "element", "name": "references", "ordinal": 0 }
          ],
          "source": { "kind": "element_content" }
        }
      },
      "test": "fixture_extracts_xml_block_text_and_mixed_content_with_canonical_markup"
    },
    {
      "id": "workflow-multiline-nested-inline",
      "kind": "success",
      "review_note": "Workflow blocks are rendered as multiline documents with repeated step elements and nested inline annotations, matching the customer payload shape from #193.",
      "template": "<workflow>{{ workflow }}</workflow>",
      "rendered": "<workflow>\n    <step>Render</step>\n    <step priority=\"high\">Review <em>then merge</em></step>\n  </workflow>",
      "expected_report": {
        "values": {
          "workflow": "\n    <step>Render</step>\n    <step priority=\"high\">Review <em>then merge</em></step>\n  "
        },
        "occurrence": {
          "variable": "workflow",
          "path": [
            { "kind": "element", "name": "workflow", "ordinal": 0 }
          ],
          "source": { "kind": "element_content" }
        }
      },
      "test": "fixture_extracts_xml_block_text_and_mixed_content_with_canonical_markup"
    },
    {
      "id": "multiple-placeholders",
      "kind": "unsupported",
      "review_note": "A block with two independent placeholders has no single value boundary and must fail closed rather than guess how to split the rendered markup.",
      "template": "<root><description>{{ first }} {{ second }}</description></root>",
      "rendered": "<root><description><b>value</b></description></root>",
      "expected_report": {
        "error_code": "ERR_EXTRACT_XML_CHILD_STRUCTURE_MISMATCH"
      },
      "test": "xml_block_multiple_placeholders_remain_unsupported"
    },
    {
      "id": "dynamic-element-name",
      "kind": "unsupported",
      "review_note": "Dynamic element names would require reconstructing template control semantics and are outside the known-template XML contract.",
      "template": "<root><{{ name }}>{{ value }}</{{ name }}></root>",
      "rendered": "<root><item>Ada</item></root>",
      "expected_report": {
        "error_code": "ERR_EXTRACT_XML_DYNAMIC_ELEMENT_NAME",
        "message_contains": "dynamic XML element names"
      },
      "test": "xml_block_dynamic_element_names_remain_unsupported"
    },
    {
      "id": "block-control-flow",
      "kind": "unsupported",
      "review_note": "A generated block cannot be safely reverse-extracted from loop output because known-template matching does not reconstruct Jinja control flow.",
      "template": "<root><description>{% for item in items %}{{ item }}{% endfor %}</description></root>",
      "rendered": "<root><description><item>Ada</item></description></root>",
      "expected_report": {
        "error_code": "ERR_EXTRACT_XML_CONTROL_FLOW_UNSUPPORTED"
      },
      "test": "xml_block_control_flow_is_rejected_before_matching_rendered_children"
    },
    {
      "id": "block-occurrence-limit",
      "kind": "input_limit",
      "review_note": "Large generated task documents must honor the same occurrence bound as scalar XML extraction so a block extension cannot create an unbounded capture path.",
      "template": "root with 10,001 item elements containing one full-content placeholder each",
      "rendered": "root with 10,001 item elements containing one strong child each",
      "expected_report": {
        "error_code": "ERR_EXTRACT_INPUT_LIMIT"
      },
      "test": "xml_block_occurrence_limit_is_a_durable_boundary"
    }
  ]
