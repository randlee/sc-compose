  "findings": [
    {
      "finding_id": "FUZZ-template-probe-dotted-expression",
      "worker_correlation_id": "template-probe",
      "status": "resolved",
      "classification": "resolved",
      "subsystem": "sc-composer.extract.xml",
      "seed": 7001,
      "description": "A dotted Jinja-looking expression is accepted as a literal variable identifier during known-template XML extraction. The behavior is deterministic, but the Phase-G contract does not say whether dotted text means a literal variable name or object-path access.",
      "template": "<root><name>{{ user.name }}</name></root>\n",
      "rendered_input": "<root><name>Ada</name></root>\n",
      "minimized_reproduction": {
        "template": "<root><name>{{ user.name }}</name></root>\n",
        "rendered_input": "<root><name>Ada</name></root>\n"
      },
      "expected_behavior": "The worker oracle expected dotted attribute syntax to be rejected with ERR_EXTRACT_UNSUPPORTED.",
      "observed_behavior": {
        "exit_code": 0,
        "values": {"user.name": "Ada"},
        "diagnostic": "WARN_EXTRACT_LOW_CONFIDENCE",
        "deterministic": true
      },
      "replay": {
        "count": 3,
        "result": "same accepted literal variable and diagnostic on all three replays"
      },
      "requirement_adr_trace": "Amended FR-16 and ADR-0011 define dotted expressions as object-field access outside Phase G's flat scalar extraction subset and require ERR_EXTRACT_UNSUPPORTED.",
      "requirement_follow_up": "Resolved by the team-lead/product-owner contract decision recorded in amended FR-16 and ADR-0011; no additional ADR is needed.",
      "recommended_change": "Reject dotted expressions at the XML extraction call site without changing the shared VariableName grammar.",
      "recommended_test": "crates/sc-composer/src/extract/tests.rs::xml_rejects_dotted_expressions_as_unsupported",
      "classification_reason": "The product decision established that dotted access is unsupported object-field syntax for the flat extraction contract; accepting it as a literal variable was therefore a confirmed contract defect.",
      "resolution": {
        "status": "resolved",
        "sprint": "G.7",
        "resolution_note": "G.7 rejects the minimized dotted-expression reproduction with ERR_EXTRACT_UNSUPPORTED and preserves underscore and hyphen scalar names.",
        "implementation": "crates/sc-composer/src/extract/xml.rs",
        "regression_test": "crates/sc-composer/src/extract/tests.rs::xml_rejects_dotted_expressions_as_unsupported"
      }
    }
  ],
  "promoted_tests": [
    {
      "finding_id": "FUZZ-template-probe-dotted-expression",
      "test": "crates/sc-composer/src/extract/tests.rs::xml_rejects_dotted_expressions_as_unsupported",
