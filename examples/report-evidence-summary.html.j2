---
metadata:
  name: report-evidence-summary
  description: Summary page for shared report evidence, panel links, and publication handoff paths.
required_variables:
  - report.title
  - report.family
  - report.generated_at
  - summary.status
  - summary.note
  - sections.key
  - sections.title
  - items.section_key
  - items.label
  - items.href
  - items.note
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #162033;
      --muted: #5a6a81;
      --paper: #f3efe6;
      --card: #fffdf8;
      --line: #d8cfbf;
      --accent: #185f5d;
      --accent-soft: #d8efed;
      --good: #256d3f;
      --shadow: 0 18px 44px rgba(22, 32, 51, 0.12);
      font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 32px;
      background:
        linear-gradient(180deg, #f9f5ec 0%, #efe9de 100%);
      color: var(--ink);
    }

    main {
      max-width: 980px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    header, section {
      padding: 24px 30px;
    }

    header {
      border-bottom: 1px solid var(--line);
      background: linear-gradient(135deg, #fefdf8 0%, #e4f1ef 100%);
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1, h2 {
      margin: 0;
    }

    .meta, .summary-note {
      margin-top: 10px;
      color: var(--muted);
    }

    .status {
      display: inline-block;
      margin-top: 14px;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--good);
      font-weight: 700;
    }

    section + section {
      border-top: 1px solid var(--line);
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 18px 0 0;
      display: grid;
      gap: 14px;
    }

    li {
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px 18px;
      background: #fffdfa;
    }

    a {
      color: var(--accent);
      font-weight: 700;
      text-decoration: none;
    }

    .item-status {
      margin-left: 8px;
      color: var(--muted);
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    p {
      margin: 10px 0 0;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <main>
    <header>
      <p class="eyebrow">{{ report.family }}</p>
      <h1>{{ report.title }}</h1>
      <div class="meta">Generated {{ report.generated_at }}</div>
      <div class="status">{{ summary.status }}</div>
      <p class="summary-note">{{ summary.note }}</p>
    </header>
    {% for section in sections %}
    <section>
      <h2>{{ section.title }}</h2>
      <ul>
        {% for item in items %}
        {% if item.section_key == section.key %}
        <li>
          <a href="{{ item.href }}">{{ item.label }}</a>
          {% if item.status is defined %}
          <span class="item-status">{{ item.status }}</span>
          {% endif %}
          <p>{{ item.note }}</p>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </main>
</body>
</html>
